{
  "name": "found-calc",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @found-calc/web dev",
    "dev:vinext": "pnpm --filter @found-calc/web dev:vinext",
    "build": "pnpm --filter @found-calc/web build",
    "build:vinext": "pnpm --filter @found-calc/web build:vinext",
    "lint": "pnpm --filter @found-calc/web lint",
    "typecheck": "pnpm --filter @found-calc/web typecheck",
    "typecheck:engine": "pnpm --filter @found-calc/engine typecheck",
    "typecheck:rules": "pnpm --filter @found-calc/rules typecheck",
    "test": "pnpm --filter @found-calc/web test",
    "test:engine": "pnpm --filter @found-calc/engine test",
    "test:rules": "pnpm --filter @found-calc/rules test",
    "verify:phase01": "node scripts/verify-phase-01.mjs",
    "verify:phase02": "node scripts/verify-phase-02.mjs",
    "test:foundation": "node --experimental-strip-types --test apps/web/tests/foundation/*.test.m* tests/foundation/*.test.m*",
    "typecheck:catalog": "pnpm --filter @found-calc/catalog typecheck",
    "test:catalog": "pnpm --filter @found-calc/catalog test",
    "verify:phase03": "node scripts/verify-phase-03.mjs",
    "verify:phase04": "node scripts/verify-phase-04.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
