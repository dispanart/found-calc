{
  "name": "@found-calc/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "vinext:check": "vinext check",
    "lint": "eslint .",
    "typecheck": "wrangler types src/worker-configuration.d.ts && tsc --noEmit && tsc --noEmit -p tests/cloudflare/tsconfig.json",
    "test:foundation": "node --experimental-strip-types --test tests/foundation/*.test.m*",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:cloudflare": "vitest run --config vitest.cloudflare.config.ts",
    "test:e2e": "playwright test",
    "test": "pnpm test:foundation && pnpm test:unit && pnpm test:cloudflare && pnpm test:e2e",
    "verify:phase01": "node ../../scripts/verify-phase-01.mjs",
    "cf:typegen": "wrangler types src/worker-configuration.d.ts"
  },
  "dependencies": {
    "@found-calc/catalog": "workspace:*",
    "@found-calc/engine": "workspace:*",
    "@found-calc/rules": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.2.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.1",
    "@cloudflare/vitest-plugin": "1.1.0",
    "@cloudflare/workers-types": "5.20260827.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.9",
    "postcss": "8.5.10",
    "shadcn": "4.19.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "vitest": "^4.1.10",
    "wrangler": "4.127.0"
  }
}
